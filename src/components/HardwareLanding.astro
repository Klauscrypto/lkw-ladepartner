---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/landing.css';
import { ui, brand } from '../i18n/ui.ts';
import { hardware, hardwareUi } from '../data/hardware.ts';

const { lang } = Astro.props;
const t = ui[lang];
const h = hardwareUi[lang];
const SITE = 'https://lkw-ladepartner.de';
const dePath = `${SITE}/ladehardware/`;
const enPath = `${SITE}/en/charging-hardware/`;
const canonical = lang === 'de' ? dePath : enPath;
const homeHref = lang === 'de' ? '/' : '/en/';
const val = (v) => (typeof v === 'string' ? v : v[lang]);

const productSchema = hardware.map((p) => ({
  "@context": "https://schema.org", "@type": "Product",
  name: `${p.brand} ${p.name}`, brand: { "@type": "Brand", name: p.brand },
  category: "EV DC fast charger", description: val(p.desc), inLanguage: t.htmlLang,
  additionalProperty: p.specs.map((s) => ({ "@type": "PropertyValue", name: s.l[lang], value: val(s.v) })),
}));
---

<!DOCTYPE html>
<html lang={t.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{h.h1} | SOMV Project Consulting</title>
  <meta name="description" content={h.lead} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={dePath} />
  <link rel="alternate" hreflang="en" href={enPath} />
  <link rel="alternate" hreflang="x-default" href={dePath} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#10362A" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
  <meta property="og:title" content={h.h1} />
  <meta property="og:description" content={h.lead} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={SITE + '/og-image.png'} />
  {productSchema.map((s) => (<script type="application/ld+json" set:html={JSON.stringify(s)} />))}
<script is:inline src="/analytics.js" defer data-ga="G-YNKTJQP7KY" data-umami="74c87d98-1b65-480c-afbb-aa128ab8253a" data-umami-src="https://stats.pilsner-vertrieb.de/script.js" data-privacy="/datenschutz" data-accent="#16a34a"></script>
</head>
<body>

<a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>

<header class="topbar">
  <div class="wrap bar">
    <a class="brand" href={homeHref}><span class="brand-mark">SOMV</span><span class="brand-sub">Project Consulting</span></a>
    <input type="checkbox" id="navtoggle" class="nav-toggle" aria-label="Menü umschalten" />
    <label for="navtoggle" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav class="nav" aria-label="Navigation">
      <a href={`${homeHref}#leistungen`}>{t.nav.leistungen}</a>
      <a href={`${homeHref}#system`}>{t.nav.system}</a>
      <a href={lang === 'de' ? '/ladehardware/' : '/en/charging-hardware/'}>{t.nav.hardware}</a>
      <a href={`${homeHref}#rechner`}>{t.nav.foerderung}</a>
    </nav>
    <div class="bar-right">
      <div class="lang-switch" aria-label="Sprache / Language">
        <a href="/ladehardware/" class={lang === 'de' ? 'on' : ''}>DE</a><span>·</span>
        <a href="/en/charging-hardware/" class={lang === 'en' ? 'on' : ''}>EN</a>
      </div>
      <span class="virta-badge">{t.nav.reseller} <strong>Virta</strong> {t.nav.resellerTail}</span>
      <a class="btn btn-sm" href={`${homeHref}#kontakt`}>{t.nav.cta}</a>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 style="max-width:840px;">{h.h1}</h1>
      <p class="lead" style="max-width:660px;">{h.lead}</p>
    </div>
  </section>

  <section class="section" style="padding-top:20px;">
    <div class="wrap hw-list">
      {hardware.map((p) => (
        <article class="hw-card">
          <div class="hw-head">
            <div>
              <span class="hw-brand">{p.brand}</span>
              <h2>{p.name}</h2>
              <p class="hw-tagline">{val(p.tagline)}</p>
            </div>
            {p.recommended && <span class="hw-badge">★ {h.recommended}</span>}
          </div>
          <p class="hw-desc">{val(p.desc)}</p>
          <div class="hw-fit"><span class="hw-fit-l">{h.fitH}:</span> {val(p.fit)}</div>
          {p.datasheet && (
            <a class="hw-datasheet" href={p.datasheet} target="_blank" rel="noopener">
              {h.datasheet} ↓
            </a>
          )}
          <div class="hw-specs">
            <p class="hw-specs-h">{h.specsH}</p>
            <dl>
              {p.specs.map((s) => (
                <div class="hw-spec"><dt>{s.l[lang]}</dt><dd>{val(s.v)}</dd></div>
              ))}
            </dl>
          </div>
        </article>
      ))}
    </div>
    <div class="wrap"><p class="hw-note">{h.note}</p></div>
  </section>

  <section id="kontakt" class="cta">
    <div class="wrap cta-in">
      <div><h2>{h.ctaH}</h2><p>{h.ctaText}</p></div>
      <div class="cta-actions">
        <a class="btn btn-amber btn-lg" href={`${homeHref}#kontakt`}>{h.cta}</a>
        <a class="btn btn-ghost-light btn-lg" href={`${homeHref}#rechner`}>{t.hero.cta2}</a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap foot-grid">
    <div>
      <div class="brand"><span class="brand-mark">SOMV</span><span class="brand-sub">Project Consulting</span></div>
      <p class="foot-note">{t.foot.note}</p>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hLeist}</p>
      <a href={`${homeHref}#leistungen`}>{t.nav.leistungen}</a>
      <a href={lang === 'de' ? '/ladehardware/' : '/en/charging-hardware/'}>{t.nav.hardware}</a>
      <a href={`${homeHref}#rechner`}>{t.foot.lRechner}</a>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hGruppe}</p>
      <a href={brand.somv} rel="noopener">SOMV Project Consulting</a>
      <a href={brand.trafo} rel="noopener">Trafo-Übergabestation</a>
      <a href={brand.sep} rel="noopener">Solar Energie Partner</a>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hKontakt}</p>
      <a href={`mailto:${brand.email}`}>{brand.email}</a>
      <span class="foot-plain">{t.foot.region}</span>
    </div>
  </div>
  <div class="wrap foot-legal">
    <span>© 2026 SOMV Project Consulting GmbH</span>
    <span class="foot-legal-links"><a href="/impressum">{t.foot.impressum}</a> · <a href="/datenschutz">{t.foot.datenschutz}</a> · <a href="#" data-consent-open>Cookies</a></span>
  </div>
</footer>

<style is:global>
  .lang-switch{display:flex;align-items:center;gap:6px;font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--steel);}
  .lang-switch a{color:var(--steel);font-weight:600;display:inline-flex;align-items:center;min-height:40px;padding:0 8px;}
  .lang-switch a.on{color:var(--forest);text-decoration:underline;}
  .hw-list{display:flex;flex-direction:column;gap:24px;}
  .hw-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:32px;}
  .hw-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;}
  .hw-brand{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--green);}
  .hw-card h2{font-size:26px;margin:6px 0 4px;}
  .hw-tagline{color:var(--steel);font-size:16px;}
  .hw-badge{flex:none;background:var(--forest);color:var(--leaf-bright);font-family:'IBM Plex Mono',monospace;
    font-size:12px;font-weight:700;padding:7px 14px;border-radius:100px;white-space:nowrap;}
  .hw-desc{font-size:16.5px;line-height:1.6;color:var(--ink-soft);margin:18px 0 14px;}
  .hw-fit{font-size:15px;color:var(--ink);background:var(--mist);border-radius:10px;padding:12px 16px;margin-bottom:20px;}
  .hw-fit-l{font-weight:700;color:var(--green);}
  .hw-datasheet{display:inline-flex;align-items:center;gap:6px;font-family:'IBM Plex Mono',monospace;
    font-size:13px;font-weight:600;color:var(--green);text-decoration:underline;margin-bottom:20px;}
  .hw-specs-h{font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--forest);font-size:15px;
    text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;}
  .hw-specs dl{display:grid;grid-template-columns:1fr 1fr;gap:0;}
  .hw-spec{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);flex-wrap:wrap;}
  .hw-spec dt{color:var(--steel);font-size:14px;min-width:0;}
  .hw-spec dd{color:var(--ink);font-size:14px;font-weight:600;text-align:right;font-family:'IBM Plex Mono',monospace;overflow-wrap:anywhere;}
  .hw-note{font-size:13px;color:var(--steel);margin-top:24px;line-height:1.55;}
  @media (max-width:700px){ .hw-specs dl{grid-template-columns:1fr;} .hw-card{padding:24px;} }
</style>
</body>
</html>
