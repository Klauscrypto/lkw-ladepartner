---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/landing.css';
import { ui, brand } from '../i18n/ui.ts';
import { regions, regionUi } from '../data/regions.ts';

const { lang, region } = Astro.props;
const t = ui[lang];
const r = regionUi[lang];
const c = region[lang];
const SITE = 'https://lkw-ladepartner.de';
const OG_IMAGE = SITE + '/og-image.png';

const dePath = `${SITE}/standort/${region.slug}/`;
const enPath = `${SITE}/en/locations/${region.slug}/`;
const canonical = lang === 'de' ? dePath : enPath;
const homeHref = lang === 'de' ? '/' : '/en/';
const regionHref = (slug) => (lang === 'de' ? `/standort/${slug}/` : `/en/locations/${slug}/`);
const others = regions.filter((x) => x.slug !== region.slug);

const title = `${r.h1pre} ${region.name} | Depotladen & ${lang === 'de' ? 'Förderung' : 'Funding'} – SOMV`;
const desc = `${c.lead} ${r.fundNote}`;

const localBusiness = {
  "@context": "https://schema.org", "@type": "LocalBusiness",
  name: "SOMV Project Consulting GmbH", url: canonical, image: OG_IMAGE,
  telephone: "+49 991 38314070", email: brand.email, priceRange: "€€€",
  address: { "@type": "PostalAddress", streetAddress: "Land-Au 8", postalCode: "94469", addressLocality: "Deggendorf", addressRegion: "Bayern", addressCountry: "DE" },
  geo: { "@type": "GeoCoordinates", latitude: 48.8339, longitude: 12.9575 },
  areaServed: { "@type": "City", name: region.name, geo: { "@type": "GeoCoordinates", latitude: region.lat, longitude: region.lng } },
  description: desc, inLanguage: t.htmlLang, sameAs: [brand.somv, brand.trafo, brand.sep, brand.waermekraft],
};
const breadcrumb = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE + homeHref },
    { "@type": "ListItem", position: 2, name: region.name, item: canonical },
  ],
};
---

<!DOCTYPE html>
<html lang={t.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={dePath} />
  <link rel="alternate" hreflang="en" href={enPath} />
  <link rel="alternate" hreflang="x-default" href={dePath} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#10362A" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
<script is:inline src="/analytics.js" defer data-ga="G-YNKTJQP7KY" data-umami="74c87d98-1b65-480c-afbb-aa128ab8253a" data-umami-src="https://stats.pilsner-vertrieb.de/script.js" data-privacy="/datenschutz" data-accent="#16a34a"></script>
</head>
<body>

<a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>

<header class="topbar">
  <div class="wrap bar">
    <a class="brand" href={homeHref}><span class="brand-mark">SOMV</span><span class="brand-sub">Project Consulting</span></a>
    <input type="checkbox" id="navtoggle" class="nav-toggle" aria-label="Menü umschalten" />
    <label for="navtoggle" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav class="nav" aria-label="Navigation">
      <a href={`${homeHref}#leistungen`}>{t.nav.leistungen}</a>
      <a href={`${homeHref}#system`}>{t.nav.system}</a>
      <a href={`${homeHref}#ablauf`}>{t.nav.ablauf}</a>
      <a href={`${homeHref}#rechner`}>{t.nav.foerderung}</a>
    </nav>
    <div class="bar-right">
      <div class="lang-switch" aria-label="Sprache / Language">
        <a href={dePath.replace(SITE, '')} class={lang === 'de' ? 'on' : ''}>DE</a><span>·</span>
        <a href={enPath.replace(SITE, '')} class={lang === 'en' ? 'on' : ''}>EN</a>
      </div>
      <span class="virta-badge">{t.nav.reseller} <strong>Virta</strong> {t.nav.resellerTail}</span>
      <a class="btn btn-sm" href="#kontakt">{t.nav.cta}</a>
    </div>
  </div>
</header>

<main id="main">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{r.eyebrow} · {region.name}</p>
      <h1 style="max-width:820px;">{r.h1pre} <span class="hl">{region.name}.</span></h1>
      <p class="lead" style="max-width:640px;">{c.lead}</p>
      <div class="hero-cta">
        <a class="btn" href="#kontakt">{t.hero.cta1}</a>
        <a class="btn btn-ghost" href={`${homeHref}#rechner`}>{t.hero.cta2}</a>
      </div>
      <div style="margin-top:26px;"><span class="pill-region">{r.fundNote}</span></div>
    </div>
  </section>

  <!-- WHY LOCATION -->
  <section class="section">
    <div class="wrap region-grid">
      <div>
        <p class="kicker">{r.whyH} {region.name}</p>
        <h2>{r.whyLede}</h2>
        <p class="section-sub" style="margin-top:16px;">{c.angle}</p>
      </div>
      <aside class="chain-teaser">
        <p class="chain-teaser-h">{r.chainH}</p>
        <p class="chain-teaser-sub">{r.chainSub}</p>
        <ul>{r.chain.map((x) => (<li>{x}</li>))}</ul>
        <a class="lcard-link" href={homeHref}>{r.backHome} →</a>
      </aside>
    </div>
  </section>

  <!-- NEARBY + OTHER REGIONS -->
  <section class="section section-mist">
    <div class="wrap region-grid">
      <div>
        <p class="kicker">{r.nearbyH}</p>
        <div class="chips">{c.nearby.map((n) => (<span class="chip">{n}</span>))}</div>
      </div>
      <div>
        <p class="kicker">{r.otherRegionsH}</p>
        <div class="region-links">
          {others.map((o) => (<a href={regionHref(o.slug)}>{o.name} →</a>))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="kontakt" class="cta">
    <div class="wrap cta-in">
      <div>
        <h2>{r.ctaH}</h2>
        <p>{r.ctaText}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-amber btn-lg" href={`mailto:${brand.email}?subject=${encodeURIComponent(t.ctaBlock.mailSubject + ' ' + region.name)}`}>{r.cta}</a>
        <a class="btn btn-ghost-light btn-lg" href="tel:+4999138314070">{t.ctaBlock.cta2}</a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap foot-grid">
    <div>
      <div class="brand"><span class="brand-mark">SOMV</span><span class="brand-sub">Project Consulting</span></div>
      <p class="foot-note">{t.foot.note}</p>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hLeist}</p>
      <a href={`${homeHref}#leistungen`}>{t.nav.leistungen}</a>
      <a href={`${homeHref}#system`}>{t.foot.lHardware}</a>
      <a href={`${homeHref}#rechner`}>{t.foot.lRechner}</a>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hGruppe}</p>
      <a href={brand.somv} rel="noopener">SOMV Project Consulting</a>
      <a href={brand.trafo} rel="noopener">Trafo-Übergabestation</a>
      <a href={brand.sep} rel="noopener">Solar Energie Partner</a>
      <a href={brand.waermekraft} rel="noopener">Wärme-Kraft Heizsysteme</a>
    </div>
    <div class="foot-links">
      <p class="foot-h">{t.foot.hKontakt}</p>
      <a href={`mailto:${brand.email}`}>{brand.email}</a>
      <span class="foot-plain">{t.foot.region}</span>
    </div>
  </div>
  <div class="wrap foot-legal">
    <span>© 2026 SOMV Project Consulting GmbH</span>
    <span class="foot-legal-links"><a href="/impressum">{t.foot.impressum}</a> · <a href="/datenschutz">{t.foot.datenschutz}</a> · <a href="#" data-consent-open>Cookies</a></span>
  </div>
</footer>

<style is:global>
  .lang-switch{display:flex;align-items:center;gap:6px;font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--steel);}
  .lang-switch a{color:var(--steel);font-weight:600;display:inline-flex;align-items:center;min-height:40px;padding:0 8px;}
  .lang-switch a.on{color:var(--forest);text-decoration:underline;}
  .pill-region{display:inline-block;background:rgba(217,145,30,.14);color:var(--amber-d);border:1px solid rgba(217,145,30,.5);
    font-size:13px;font-weight:600;padding:8px 16px;border-radius:100px;font-family:'IBM Plex Mono',monospace;}
  .region-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:40px;align-items:start;}
  .chain-teaser{background:var(--mist);border:1px solid var(--line);border-radius:16px;padding:26px;}
  .chain-teaser-h{font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--forest);font-size:18px;margin-bottom:6px;}
  .chain-teaser-sub{font-size:14px;color:var(--steel);margin-bottom:14px;}
  .chain-teaser ul{list-style:none;margin-bottom:16px;}
  .chain-teaser li{position:relative;padding-left:24px;margin-bottom:9px;font-size:15px;color:var(--ink-soft);}
  .chain-teaser li::before{content:"";position:absolute;left:0;top:7px;width:10px;height:10px;border-radius:3px;background:var(--leaf);}
  .chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;}
  .chip{background:#fff;border:1px solid var(--line);border-radius:100px;padding:8px 16px;font-size:14px;color:var(--ink-soft);}
  .region-links{display:flex;flex-direction:column;gap:10px;margin-top:14px;}
  .region-links a{font-family:'Space Grotesk',sans-serif;font-weight:600;color:var(--green);font-size:16px;}
  .region-links a:hover{color:var(--leaf);}
  @media (max-width:820px){ .region-grid{grid-template-columns:1fr;} }
</style>
</body>
</html>
