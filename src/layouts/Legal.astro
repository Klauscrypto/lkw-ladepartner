---
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
const { title, description } = Astro.props;
const SITE = 'https://lkw-ladepartner.de';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Lkw-Ladepartner · SOMV Project Consulting</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={SITE + Astro.url.pathname} />
  <meta name="theme-color" content="#10362A" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<script is:inline src="/analytics.js" defer data-ga="G-XXXXXXXXXX" data-umami="74c87d98-1b65-480c-afbb-aa128ab8253a" data-umami-src="https://stats.pilsner-vertrieb.de/script.js" data-privacy="/datenschutz" data-accent="#16a34a"></script>
</head>
<body>
  <header class="lhead">
    <div class="lwrap">
      <a class="brand" href="/"><span class="brand-mark">SOMV</span><span class="brand-sub">Project Consulting</span></a>
      <a class="back" href="/">← Zur Startseite</a>
    </div>
  </header>

  <main class="lwrap legal">
    <h1>{title}</h1>
    <slot />
  </main>

  <footer class="lfoot">
    <div class="lwrap">© 2026 SOMV Project Consulting GmbH · <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a> · <a href="#" data-consent-open>Cookies</a></div>
  </footer>

  <style is:global>
    :root{--ink:#0F2E23;--forest:#10362A;--green:#1C6B4C;--leaf:#3E9E2C;--paper:#F4F6F3;--steel:#5B6C64;--line:#D5DFD7;--soft:#33463D;}
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:'IBM Plex Sans',system-ui,'DejaVu Sans',sans-serif;color:var(--soft);background:var(--paper);line-height:1.65;}
    .lwrap{max-width:820px;margin:0 auto;padding:0 24px;}
    a{color:var(--green);}
    .lhead{border-bottom:1px solid var(--line);background:#fff;}
    .lhead .lwrap{display:flex;align-items:center;justify-content:space-between;height:66px;}
    .brand{display:flex;flex-direction:column;line-height:1;text-decoration:none;}
    .brand-mark{font-family:'Space Grotesk',sans-serif;font-size:21px;font-weight:700;color:var(--forest);letter-spacing:1px;}
    .brand-sub{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--steel);margin-top:2px;}
    .back{font-size:14px;font-weight:600;text-decoration:none;}
    .legal{padding:52px 24px 80px;}
    .legal h1{font-family:'Space Grotesk',sans-serif;font-size:34px;color:var(--ink);margin-bottom:26px;letter-spacing:-.5px;}
    .legal h2{font-family:'Space Grotesk',sans-serif;font-size:20px;color:var(--forest);margin:30px 0 10px;}
    .legal h3{font-size:16px;color:var(--ink);margin:20px 0 6px;font-weight:600;}
    .legal p,.legal li{font-size:16px;margin-bottom:12px;}
    .legal ul{padding-left:22px;margin-bottom:12px;}
    .legal a{word-break:break-word;}
    .ph{background:#FBF3DE;border:1px solid #E6CE86;color:#6b551d;border-radius:8px;padding:14px 16px;font-size:14.5px;margin-bottom:28px;}
    .ph strong{color:#5a4712;}
    mark{background:#FCEFC6;padding:0 3px;border-radius:3px;}
    .lfoot{border-top:1px solid var(--line);background:#fff;padding:22px 0;font-size:13px;color:var(--steel);}
    .lfoot a{color:var(--steel);}
  </style>
</body>
</html>
